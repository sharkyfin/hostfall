.hf2-computer { background-color: rgb(10,18,23); color: rgb(212,227,229); font-size: 23px; padding: 0; border-width: 0; border-radius: 0; overflow: hidden; }
.hf2-computer Button { min-height: 42px; padding: 8px 15px; margin: 4px; font-size: 23px; }
.hf2-computer Label { white-space: normal; }
.hf2-home-external { position: absolute; top: 24px; left: 24px; bottom: 24px; width: 62%; max-width: 760px; align-items: flex-start; }
.front-stacked .hf2-home-external { left: 24px; width: auto; max-width: none; }
.hf2-home-external > Button { font-size: 18px; min-height: 36px; padding: 6px 16px; background-color: rgb(22,39,45); color: rgb(225,239,238); border-width: 1px; border-color: rgb(86,139,148); }
.hf2-knowledge-hint { font-size: 14px; max-width: 360px; white-space: normal; color: rgb(224,234,233); background-color: rgba(13,23,29,0.96); padding: 8px 12px; margin-top: 7px; }
.hf2-home-knowledge { flex-grow: 1; width: 100%; min-height: 0; margin-top: 8px; padding: 16px; background-color: rgb(13,23,29); color: rgb(218,232,234); border-width: 1px; border-color: rgb(62,103,112); }
.hf2-home-knowledge .hf2-guide-list { width: 31%; margin-right: 12px; }
.hf2-home-knowledge .hf2-guide-list Button { white-space: normal; -unity-text-align: middle-left; }
.hf2-archive-label { font-size: 13px; color: rgb(156,187,190); margin: 10px 4px 6px; }
.hf2-home-knowledge .hf2-heading { font-size: 20px; }
.hf2-home-knowledge .hf2-prose { font-size: 15px; }
.hf2-home-content { flex-grow: 1; padding: 22px; }
.hf2-shell-output { flex-grow: 1; background-color: rgb(7,13,18); padding: 14px; }
.hf2-transcript { -unity-font: url("../Content/Fonts/RobotoMono-Regular.ttf"); -unity-text-align: upper-left; flex-shrink: 0; font-size: 25px; color: rgb(197,225,214); white-space: normal; }
.hf2-shell-input { margin-top: 15px; font-size: 25px; color: rgb(222,236,233); }
.hf2-shell-input > .unity-text-field__label { min-width: 280px; }
.hf2-shell-input > .unity-text-field__input { background-color: rgb(11,25,28); color: rgb(238,244,237); padding: 10px; }
.hf2-prose { white-space: normal; margin: 10px 10px 18px 10px; }
.hf2-heading { font-size: 28px; -unity-font-style: bold; margin: 18px 10px; }
.hf2-guide-row { flex-direction: row; flex-grow: 1; margin-top: 15px; }
.hf2-guide-list { width: 410px; margin-right: 24px; }
.hf2-guide-text { flex-grow: 1; background-color: rgb(13,24,30); padding: 18px; }
.hf2-win98 { background-color: rgb(34,91,94); color: black; }
.hf2-icons { position: absolute; left: 16px; top: 25px; width: 175px; }
.hf2-icons Button { background-color: rgba(0,0,0,0); color: white; border-width: 0; min-height: 95px; white-space: normal; }
.hf2-window { position: absolute; background-color: rgb(192,195,191); border-left-color: white; border-top-color: white; border-right-color: rgb(38,44,42); border-bottom-color: rgb(38,44,42); border-width: 3px; padding: 3px; }
.hf2-titlebar { flex-direction: row; background-color: rgb(20,44,106); height: 49px; color: white; align-items: center; }
.hf2-window-title { flex-grow: 1; font-size: 23px; -unity-font-style: bold; padding-left: 10px; white-space: nowrap; }
.hf2-titlebar Button { min-height: 31px; height: 32px; min-width: 38px; padding: 0 7px; margin: 3px; }
.hf2-window-body { flex-grow: 1; padding: 12px; }
.hf2-window Button, .hf2-taskbar Button { background-color: rgb(192,195,191); color: black; border-radius: 0; border-left-color: white; border-top-color: white; border-right-color: rgb(38,44,42); border-bottom-color: rgb(38,44,42); border-width: 2px; }
.hf2-window .hf2-prose { color: rgb(20,24,23); }
.hf2-file-path { background-color: white; color: black; padding: 10px; margin-bottom: 20px; }
.hf2-taskbar { position: absolute; bottom: 0; left: 0; right: 0; height: 57px; background-color: rgb(192,195,191); flex-direction: row; border-top-width: 2px; border-top-color: white; align-items: center; }
.hf2-start { -unity-font-style: bold; padding: 12px; color: black; }
.hf2-taskbar .hf2-task-active { background-color: rgb(224,230,221); border-top-color: rgb(38,44,42); border-left-color: rgb(38,44,42); }
.hf2-snake-status { height: 39px; color: rgb(20,34,27); font-size: 22px; }
.hf2-snake-board { width: 768px; height: 480px; flex-direction: row; flex-wrap: wrap; align-self: center; background-color: rgb(6,14,10); }
.hf2-snake-cell { width: 48px; height: 40px; border-width: 1px; border-color: rgb(20,34,26); flex-shrink: 0; }
.hf2-game-controls { flex-direction: row; align-items: center; margin-top: 12px; }

.hf2-service { flex-grow: 1; flex-shrink: 1; min-height: 0; padding: 24px 30px; background-color: rgb(13,23,29); color: rgb(215,233,230); }
.hf2-service-tabs { flex-direction: row; border-bottom-width: 1px; border-bottom-color: rgb(56,86,88); padding-bottom: 12px; margin-bottom: 10px; }
.hf2-service-split { flex-direction: row; flex-grow: 1; min-height: 0; }
.hf2-service-files { width: 32%; flex-shrink: 0; border-right-width: 1px; border-right-color: rgb(56,86,88); padding-right: 12px; }
.hf2-service-content { flex-grow: 1; flex-shrink: 1; min-width: 0; padding-left: 16px; }
.hf2-service Button { color: rgb(212,233,230); background-color: rgb(24,42,47); border-width: 1px; border-color: rgb(65,98,102); white-space: normal; min-height: 46px; }
.hf2-service Button:hover { background-color: rgb(39,68,72); }
.hf2-service Button.hf2-service-selected { border-color: rgb(122,189,167); background-color: rgb(40,78,70); }
.hf2-service-files Button { -unity-text-align: middle-left; }
.hf2-service-status { min-height: 52px; color: rgb(228,203,159); margin: 0; padding: 12px 4px 0 4px; font-size: 23px; }
.hf2-service-code { background-color: rgb(7,17,22); color: rgb(144,196,170); padding: 18px; margin: 8px 0; }
.hf2-service-options { flex-direction: row; flex-wrap: wrap; }
.hf2-service-camera { flex-grow: 1; flex-basis: 0; min-width: 0; margin: 4px; background-color: rgb(21,36,42); border-width: 1px; border-color: rgb(65,98,102); }
.hf2-service-camera .hf2-prose { margin: 6px 10px; }
.hf2-frame { width: 100%; min-width: 0; height: 148px; flex-shrink: 0; background-color: rgb(12,24,28); }
